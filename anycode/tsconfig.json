{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "..",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "anycode-agent": ["../anycode-agent/src"],
      "anycode-agent/*": ["../anycode-agent/src/*"],
      "anycode-editor": ["../anycode-editor/core/src"],
      "anycode-editor/*": ["../anycode-editor/core/src/*"],
      "anycode-editor-react": ["../anycode-editor/react/src"],
      "anycode-editor-react/*": ["../anycode-editor/react/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
